# Database Configuration
MONGODB_URI=mongodb://localhost:27017/agrivision
# For MongoDB Atlas (cloud), use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/agrivision?retryWrites=true&w=majority

# Server Configuration
PORT=3000
HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Environment
NODE_ENV=development

# Optional: Logging
LOG_LEVEL=info

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Predictions / scan history (MongoDB) — required until JWT is used on /predict
# Option A: MongoDB ObjectId of an existing user
# DEFAULT_PREDICTION_USER_ID=507f1f77bcf86cd799439011
# Option B: look up by email (default: farmer@example.com from db:insert-users)
# DEFAULT_PREDICTION_USER_EMAIL=farmer@example.com
